[Unit]
Description=Game on tty1
After=systemd-user-sessions.service getty@tty1.service
Conflicts=getty@tty1.service

[Service]
Type=simple
User=stepmania
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
ExecStart=/usr/bin/xinit /home/stepmania/run_game.sh -- vt1 -nocursor
Restart=always
RestartSec=3
StartLimitIntervalSec=10
StartLimitBurst=2

[Install]
WantedBy=graphical.target
