[Unit]
Description=Settings in tty2
After=systemd-user-sessions.service getty@tty2.service
Conflicts=getty@tty2.service

[Service]
Type=simple
User=stepmania
PAMName=login
TTYPath=/dev/tty2
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty2
UtmpMode=user
ExecStart=/usr/bin/xinit /usr/local/bin/tty2-firefox.sh -- vt2 
Restart=always
RestartSec=3
