      x86_64: "https://github.com/pnn64/deadsync/releases/download/v0.5.120/deadsync-v0.5.120-x86_64-linux.tar.gz"
      arm64: "https://github.com/pnn64/deadsync/releases/download/v0.5.120/deadsync-v0.5.120-arm64-linux.tar.gz"
    dest: "/home/stepmania/game/deadsync0-5-120"
    config_file: "/home/stepmania/.local/share/deadsync/deadsync.ini"
    binary_path: "/home/stepmania/game/deadsync0-5-120/deadsync"
    extract_opts: ["--strip-components=1"]
    dependencies: []
  itgmania-1-3-0:
