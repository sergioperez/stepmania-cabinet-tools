    dest: "/home/stepmania/game/itgmania130"
    config_file: "/home/stepmania/.itgmania/Save/Preferences.ini"
    binary_path: "/home/stepmania/game/itgmania130/itgmania"
    extract_opts: ["--strip-components=2"]
    dependencies: []
  itgmania-1-2-1:
    url:
      x86_64: "https://github.com/itgmania/itgmania/releases/download/v1.2.1/ITGmania-1.2.1-Linux.tar.gz"
      arm64: "https://github.com/sergioperez/itgmania/releases/download/v1.2.1/ITGmania-1.2.1-Linux-arm64-no-songs.tar.gz"
    dest: "/home/stepmania/game/itgmania121"
    config_file: "/home/stepmania/.itgmania/Save/Preferences.ini"
    binary_path: "/home/stepmania/game/itgmania121/itgmania"
    extract_opts: ["--strip-components=2"]
    dependencies: []

